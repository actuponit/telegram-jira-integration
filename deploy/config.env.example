# Copy to deploy/config.env and fill in. deploy/config.env is gitignored —
# it holds project coordinates and non-secret config only. Real secrets live
# in Google Secret Manager (ADR-0001), never here.

# --- GCP coordinates ---
PROJECT_ID=my-gcp-project
REGION=europe-west1
SERVICE_NAME=telegram-jira-bot
AR_REPO=telegram-jira-bot
RUNTIME_SA_NAME=telegram-jira-bot-run

# --- Non-secret runtime config (plain Cloud Run env vars) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_PROJECT_KEY=MA
# Comma-separated Telegram chat IDs. Startup fails if empty (ticket 03).
TELEGRAM_ALLOWED_CHATS=-1001234567890
